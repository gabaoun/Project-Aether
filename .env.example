# Core API Keys
GROQ_API_KEY=your_groq_api_key_here

# Chroma Cloud
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=d229b721-6e42-4d8a-800d-54f2d56651a6
CHROMA_DATABASE=RAGabaoun
CHROMA_COLLECTION=project_aether_docs

# Redis Semantic Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
SEMANTIC_CACHE_THRESHOLD=0.85

# Neo4j Graph Database
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# LangChain RAG chain (/query/langchain) - OFF by default. Importing
# langchain-core alone costs ~230-290MB RSS (measured), which alone eats
# most of Render's 512MB free-tier budget. Only enable on a host with
# headroom beyond the free tier.
ENABLE_LANGCHAIN_ENGINE=false

# Application Settings
LOG_LEVEL=INFO
DATA_DIR=./data

# Shared secret required (X-Admin-Token header) to call POST /ingest.
# Leave unset for local dev; set a random value on any public deploy.
ADMIN_TOKEN=
